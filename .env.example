# =========================
# PUBLIC / INTERNAL / HOST PORTS
# =========================
NGINX_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Порты сервисов, доступных только изнутри compose, наружу не публикуются:
# chat-svc и library-svc — потому что проверку JWT делает nginx, а сами сервисы
# доверяют его заголовкам; ingest-worker — потому что у него нет HTTP-сервера.
# Значения ниже оставлены для справки и compose'ом не используются.
AUTH_PUBLIC_PORT=3000
CHAT_PUBLIC_PORT=8000
INGESTWORKER_PUBLIC_PORT=5235
LIBRARY_PUBLIC_PORT=4500

# Публикуются только на 127.0.0.1 — доступны с самой машины для отладки.
GRAPH_RAG_PUBLIC_PORT=4100
DBSVC_PUBLIC_PORT=3401
EMBEDDING_PUBLIC_PORT=3500


# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
# Слабые значения заменяет `python3 scripts/gen_minio_credentials.py`
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=documents
# Бакет аватаров пользователей (auth-svc); создаёт minio-init
MINIO_AVATARS_BUCKET=avatars
MINIO_REGION=us-east-1
MINIO_SECURE=false

# =========================
# SERVICE DB USERS
# =========================

DBSVC_ADMIN_TOKEN=123456

POSTGRES_DB=app_db
POSTGRES_ADMIN_USER=app_user
POSTGRES_ADMIN_PASSWORD=app_password

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_password

LIBRARY_DB_USER=library_user
LIBRARY_DB_PASSWORD=library_password

GRAPH_DB_USER=graph_user
GRAPH_DB_PASSWORD=graph_password

INGEST_DB_USER=ingest_user
INGEST_DB_PASSWORD=ingest_password

DBSVC_DB_USER=dbsvc_user
DBSVC_DB_PASSWORD=dbsvc_password

# POSTGRES_ADMIN_* — суперпользователь контейнера postgres. Он нужен только инициализации,
# миграциям и оператору; ни один сервис под ним не подключается. У каждого сервиса своя
# роль выше, права описаны в infra/db/init/roles/grants.sql (обзор — infra/db/README.md).
# Пароли ролей применяются при инициализации пустого тома; на существующей базе их
# обновляет infra/db/init/roles/sync.sql.


EMBEDDER_MODEL_NAME=intfloat/multilingual-e5-base
# Размерность векторов этой модели. Должна совпадать с VECTOR(N) в схеме БД —
# сервисы сверяют это при запуске и не стартуют при расхождении.
# Смена модели эмбеддингов = пересчёт всех чанков и всего графа, см. README graph-rag-svc §13.1.
EMBEDDING_DIM=768
OLLAMA_MODEL=mistral

# Ключ внешнего LLM-роутера для llm-proxy (режим router). Хранится только здесь и в окружении
# контейнера llm-proxy: в config.json, логи и ответы не попадает. Пустой ключ — режим router
# отвечает 503. Режим, модели и адреса — в config.json на томе llm_proxy_config (infra/llm-proxy/README.md).
ROUTER_KEY=

# =========================
# NETWORK ADDRESSES (internal)
# =========================
POSTGRES_HOST=postgres
REDIS_HOST=redis
AUTH_HOST=auth-svc
CHAT_HOST=chat-svc


AUTH_DATABASE_URL=postgresql+asyncpg://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
CHAT_DATABASE_URL=postgresql+asyncpg://${CHAT_DB_USER}:${CHAT_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
INGESTWOKRER_DATABASE_URL=postgresql+asyncpg://${INGEST_DB_USER}:${INGEST_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
LIBRARY_DATABASE_URL=postgresql+asyncpg://${LIBRARY_DB_USER}:${LIBRARY_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
GRAPH_RAG_DATABASE_URL=postgresql+asyncpg://${GRAPH_DB_USER}:${GRAPH_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
# Ставить ли в образ graph-rag-svc torch/transformers/accelerate (~5 ГБ колёс nvidia-*).
# Нужны только провайдеру LLM_PROVIDER=local, который предназначен для локальной разработки
# и не должен работать в прод-среде. С false образ собирается за пару минут вместо часа.
GRAPH_RAG_WITH_LOCAL_LLM=false

# Профили compose, включённые по умолчанию.
# `llm` — сервисы ollama и ollama-init. Они вынесены в профиль, потому что резервируют GPU и
# на машине без nvidia container toolkit не стартуют, а `docker compose up` поднимает всё
# сразу: без профиля такая машина не смогла бы запустить и остальной стек.
# Убирайте `llm` отсюда, если GPU нет или LLM_PROVIDER не равен `ollama` — тогда эти два
# контейнера поднимаются только явным `docker compose --profile llm up -d`.
COMPOSE_PROFILES=llm

# Порт ollama публикуется только на 127.0.0.1 (у сервиса нет аутентификации). На доступ
# graph-rag-svc это не влияет: он ходит на http://ollama:11434 внутри сети app-network.
OLLAMA_PORT=11434

# Срок жизни сертификатов внутреннего CA (профиль compose pki, infra/pki/README.md).
# Относится к новым сертификатам; применяется при (пере)запуске step-ca.
PKI_CERT_TTL=24h

# Способ входа ролей сервисов в Postgres: password (по умолчанию) или cert. Режим cert работает
# только вместе с docker-compose.pki.yml (infra/db/README.md): у роли пропадает пароль, а вход
# идёт по клиентскому сертификату, CN которого равен имени роли.
# AUTH_DB_AUTH=password
# CHAT_DB_AUTH=password
# LIBRARY_DB_AUTH=password
# INGEST_DB_AUTH=password
# GRAPH_DB_AUTH=password
# DBSVC_DB_AUTH=password

# ===== Наблюдаемость (docker-compose.observability.yml) =====
# Пароль администратора Grafana; порт публикуется только на 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3000
# Конфигурация Prometheus: prometheus.yml (простой режим) или prometheus.mtls.yml (за mTLS).
PROMETHEUS_CONFIG=prometheus.yml
# Роль postgres_exporter (infra/db/init/roles/monitoring.sql). Создаётся при инициализации базы
# или через sync.sql; пароль обязателен, если подключён docker-compose.observability.yml.
MONITORING_DB_USER=monitoring_user
MONITORING_DB_PASSWORD=CHANGE_ME
# За docker-compose.pki.yml Postgres принимает только TLS: sslmode=require (задаёт mtls-оверлей).
# MONITORING_DB_SSLMODE=disable
# За mTLS пароль Redis для redis_exporter выпускает scripts/gen_redis_acl.py: REDIS_PROMETHEUS_PASSWORD.
