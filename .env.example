# =========================
# PUBLIC / INTERNAL / HOST PORTS
# =========================
NGINX_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

AUTH_PUBLIC_PORT=3000
CHAT_PUBLIC_PORT=8000
INGESTWORKER_PUBLIC_PORT=5235
RAG_PUBLIC_PORT=3245
LLM_PUBLIC_PORT=4000
DBSVC_PUBLIC_PORT=3401
LIBRARY_PUBLIC_PORT=4500
EMBEDDING_PUBLIC_PORT=3500


# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_REGION=us-east-1
MINIO_SECURE=false

# =========================
# SERVICE DB USERS
# =========================

DBSVC_ADMIN_TOKEN=123456

POSTGRES_DB=app_db
POSTGRES_ADMIN_USER=app_user
POSTGRES_ADMIN_PASSWORD=app_password

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_password

LIBRARY_DB_USER=library_user
LIBRARY_DB_PASSWORD=library_password



EMBEDDER_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1
OLLAMA_MODEL=mistral

# =========================
# NETWORK ADDRESSES (internal)
# =========================
POSTGRES_HOST=postgres
REDIS_HOST=redis
AUTH_HOST=auth-svc
CHAT_HOST=chat-svc


AUTH_DATABASE_URL=postgresql+asyncpg://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
CHAT_DATABASE_URL=postgresql+asyncpg://${CHAT_DB_USER}:${CHAT_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
INGESTWOKRER_DATABASE_URL=postgresql+asyncpg://${LIBRARY_DB_USER}:${LIBRARY_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
RAG_DATABASE_URL=postgresql+asyncpg://${LIBRARY_DB_USER}:${LIBRARY_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
LLM_DATABASE_URL=postgresql+asyncpg://${LIBRARY_DB_USER}:${LIBRARY_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
LIBRARY_DATABASE_URL=postgresql+asyncpg://${LIBRARY_DB_USER}:${LIBRARY_DB_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}