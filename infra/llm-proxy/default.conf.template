# llm-proxy: OpenAI-совместимый вход для graph-rag-svc. Куда уходит запрос (роутер или Ollama) и с
# какой моделью, решает llm.js по /etc/llm-proxy/config.json, который читается на каждом запросе.
#
# Шаблон: при старте контейнера envsubst образа пишет его в /etc/nginx/conf.d/default.conf.
# entrypoint.sh ограничивает подстановку переменными LLM_PROXY_* (NGINX_ENVSUBST_FILTER), поэтому
# переменные nginx ниже не трогаются, а ключ роутера не может попасть в файл конфигурации.
# Подставляется одна переменная — адрес обычного HTTP-входа (см. server ниже).

js_path   /etc/nginx/llm-proxy/;
js_import llm from llm.js;

# Последняя корректная конфигурация — общая для всех рабочих процессов и переживает reload.
js_shared_dict_zone zone=llm_proxy:1m type=string;

# Что выбрал llm.js для текущего запроса. Заполняются в llm.route и доживают до именованных
# location после r.internalRedirect: тело с подменённой моделью, адрес upstream, режим, модель.
js_var $llm_body;
js_var $llm_url;
js_var $llm_mode;
js_var $llm_model;
# «Bearer <ключ>» для режима router; вычисляется только в location @router.
js_set $llm_router_auth llm.routerAuth;

# Адрес upstream приходит из файла, поэтому proxy_pass с переменной и имена разрешаются на каждом
# запросе через DNS docker. Неразрешимое имя даёт 502 на запрос, а не падение nginx при старте.
resolver 127.0.0.11 ipv6=off valid=30s;
resolver_timeout 5s;

# Лог без заголовков и тел: ни ключа, ни Authorization клиента, ни текста вопросов.
log_format llm_proxy '$remote_addr [$time_local] "$request_method $uri" $status '
                     '$body_bytes_sent $request_time mode=$llm_mode model=$llm_model '
                     'upstream_status=$upstream_status client_dn="$ssl_client_s_dn"';
access_log /var/log/nginx/access.log llm_proxy;

# Тело целиком в памяти: njs читает его из r.requestText, во временный файл оно попадать не должно.
client_max_body_size        1m;
client_body_buffer_size     1m;
client_body_in_single_buffer on;

# Ответ модели идёт потоком (SSE) — без буферизации; генерация бывает долгой.
proxy_http_version    1.1;
proxy_buffering       off;
proxy_cache           off;
proxy_connect_timeout 10s;
proxy_send_timeout    180s;
proxy_read_timeout    180s;
proxy_ssl_server_name on;
proxy_ssl_protocols   TLSv1.2 TLSv1.3;

# Обычный HTTP, адрес — из переменной LLM_PROXY_LISTEN. Без оверлея mTLS это 8080, сюда ходит
# graph-rag-svc. С оверлеем — 127.0.0.1:8080: остаётся только для проверки живости изнутри контейнера, а снаружи
# доступен лишь порт 8443 с проверкой сертификата (infra/mtls/llm-proxy.conf).
server {
    listen ${LLM_PROXY_LISTEN};
    server_name llm-proxy;

    include /etc/nginx/llm-proxy/locations.conf;
}
